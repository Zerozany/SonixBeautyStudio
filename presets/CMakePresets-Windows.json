{
    "version": 4,
    "configurePresets": [
        {
            "name": "BaseWindows",
            "hidden": true,
            "environment": {
                "VCINSTALLDIR": "D:/MSVC/BuildTools/VC",
                "Qt6_BIN_DIR": "D:/Qt/6.10.1/msvc2022_64/bin"
            },
            "cacheVariables": {
                "CMAKE_PREFIX_PATH": "D:/Qt/6.10.1/msvc2022_64",
                "CMAKE_TOOLCHAIN_FILE": "D:/vcpkg/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_TARGET_TRIPLET": "x64-windows-static-md",
                "VCPKG_MANIFEST_DIR": "${sourceDir}/thirdparty/QZeroPackage"
            }
        },
        {
            "name": "WindowsDebug",
            "inherits": [
                "BaseWindows"
            ],
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "WindowsRelease",
            "inherits": [
                "BaseWindows"
            ],
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "WindowsDebugBuild",
            "configurePreset": "WindowsDebug",
            "jobs": 8,
            "configuration": "Debug"
        },
        {
            "name": "WindowsReleaseBuild",
            "configurePreset": "WindowsRelease",
            "jobs": 8,
            "configuration": "Release"
        }
    ]
}
