{
    "version": 4,
    "configurePresets": [
        {
            "name": "BaseUnix",
            "hidden": true,
            "environment": {
                "Qt6_BIN_DIR": "/home/Zero/Qt/6.12.0/gcc_64/bin"
            },
            "cacheVariables": {
                "CMAKE_PREFIX_PATH": "/home/Zero/Qt/6.12.0/gcc_64",
                "CMAKE_TOOLCHAIN_FILE": "/home/Zero/Tools/vcpkg/scripts/buildsystems/vcpkg.cmake",
                "VCPKG_TARGET_TRIPLET": "x64-linux",
                "VCPKG_MANIFEST_DIR": "${sourceDir}/thirdparty/QZeroPackage"
            }
        },
        {
            "name": "UnixDebug",
            "inherits": [
                "BaseUnix"
            ],
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "UnixRelease",
            "inherits": [
                "BaseUnix"
            ],
            "binaryDir": "${sourceDir}/build/${presetName}",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "UnixDebugBuild",
            "configurePreset": "UnixDebug",
            "jobs": 8,
            "configuration": "Debug"
        },
        {
            "name": "UnixReleaseBuild",
            "configurePreset": "UnixRelease",
            "jobs": 8,
            "configuration": "Release"
        }
    ]
}
